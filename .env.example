# Copy to .env and change the values:  cp .env.example .env
# The real .env is in .gitignore -- never commit it.

# --- PostgreSQL server (one server, two databases: eco + airflow) ---
POSTGRES_USER=eco_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=eco
AIRFLOW_DB=airflow
POSTGRES_PORT=5432

# --- App roles (created later by R3's sql/00_databases_roles.sql) ---
ETL_USER_PASSWORD=change_me_etl
READER_PASSWORD=change_me_reader

# --- Airflow ---
AIRFLOW_VERSION=2.11.0
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
# Local-dev keys only. Generate your own for anything public:
#   openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=oQjJSe9ong8mDLV0I17DlJ6fG7oe-oHdqVnIv06lIe8=
AIRFLOW_SECRET_KEY=change_me_secret